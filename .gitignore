# Virtual environment
venv/
# per-host venvs created by install.sh on shared/multi-machine mounts
venv-*/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# OS
.DS_Store
Thumbs.db

# Downloads (don't track downloaded content)
downloads/
# privacy-guard: per-clone patterns file (gitignored; see .privacy-patterns.example)
.privacy-patterns
# privacy-guard: privacy-related script log output (audit, host gates, etc.)
.gsd-logs/
# privacy-guard: track .claude/settings.json (project hook config), ignore the rest
.claude/*
!.claude/settings.json
# privacy-guard: per-clone trusted-SSID allowlist for lan-guard (gitignored — SSIDs are network identifiers)
.lan-allow
# privacy-guard: local script log output (audit, host gates, build/test logs)
.dev-logs/
# privacy-guard: wireless capture log — holds live-air network identifiers
*.kismet
# privacy-guard: wireless capture journal — same content, same rule
*.kismet-journal
